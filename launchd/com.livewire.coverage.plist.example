<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Coverage freshness pass. Split out of the daily job because every budget
  guessed for it expired: 600s from 2026-07-07, then 1800s from PR #78, while
  a cold full pass measured 2858s on 2026-08-09. The runtime is dominated by
  cold metadata reads on the external lake volume, so the number was never the
  bug — putting a guessed timeout around it was. This job has no timeout.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.livewire.coverage</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Replace /path/to/warehouse with your actual warehouse path. Runs the
             immutable release `current` points at, like the other three jobs. -->
        <string>cd /path/to/warehouse/current &amp;&amp; .venv/bin/python scripts/livewire_quality.py coverage</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Target: 15:05 UTC daily — five minutes past the session due -->
        <!-- instant (next-day 06:00Z job start + 9h delivery allowance = -->
        <!-- 15:00Z; T10 postmortem). The job itself then waits for upstream -->
        <!-- runs to close and for session_due_at to pass — up to 6h, -->
        <!-- overridable with LW_COVERAGE_MAX_WAIT_S — so the clock is a start -->
        <!-- hint, not the correctness gate. -->
        <!-- launchd has no TimeZone key, so Hour/Minute are Mac-local: -->
        <!--   Asia/Hong_Kong:      Hour=23 Minute=5 -->
        <!--   America/New_York:    Hour=11 Minute=5  (EDT) -->
        <!--   Europe/London:       Hour=16 Minute=5  (BST) -->
        <!--   UTC:                 Hour=15 Minute=5 -->
        <!-- Production moved 19:00 → 23:05 HKT on 2026-09-12 (T13). -->
        <!-- Defaults below assume Asia/Hong_Kong. -->
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/path/to/warehouse/logs/launchd/com.livewire.coverage.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/path/to/warehouse/logs/launchd/com.livewire.coverage.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- /opt/homebrew/bin is load-bearing: coverage shells out for recovery
             and sends its alert through the Nodemailer CLI. Without it launchd's
             minimal PATH cannot find `node` and the alert dies. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
