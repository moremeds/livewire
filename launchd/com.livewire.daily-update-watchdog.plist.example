<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.livewire.daily-update-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Replace /path/to/warehouse with your actual warehouse path. Runs the
             immutable release `current` points at, not the dev checkout. -->
        <string>cd /path/to/warehouse/current &amp;&amp; .venv/bin/python scripts/livewire_quality.py watchdog</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Target: 10:30 UTC daily (= 06:30 ET), ~5.5h after the daily-update window -->
        <!-- starts at 05:05 UTC. Detects missed or stalled sync runs. launchd interprets -->
        <!-- Hour/Minute in the Mac's local TZ; choose values that map to 10:30 UTC. Examples: -->
        <!--   America/Los_Angeles: Hour=3  Minute=30 -->
        <!--   America/New_York:    Hour=6  Minute=30 -->
        <!--   UTC:                 Hour=10 Minute=30 -->
        <!--   Asia/Hong_Kong:      Hour=18 Minute=30 -->
        <!-- Defaults below assume Asia/Hong_Kong. -->
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/com.livewire.daily-update-watchdog.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.livewire.daily-update-watchdog.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
