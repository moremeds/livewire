<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.livewire.daily-update-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Replace /path/to/warehouse with your actual warehouse path. Runs the
             immutable release `current` points at, not the dev checkout. -->
        <string>cd /path/to/warehouse/current &amp;&amp; .venv/bin/python scripts/livewire_quality.py watchdog</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <!-- First: 10:30 UTC daily (= 06:30 ET), ~5.5h after the daily-update window -->
        <!-- starts at 05:05 UTC. Detects missed or stalled sync runs. -->
        <!-- Second: 12:00 UTC, after coverage (verified 11:00Z on the mini), so a -->
        <!-- coverage-degraded status pages before the 12:15Z digest reports it. -->
        <!-- launchd interprets Hour/Minute in the Mac's local TZ; choose values that -->
        <!-- map to 10:30 and 12:00 UTC. Examples for 10:30 / 12:00: -->
        <!--   America/Los_Angeles: Hour=3  Minute=30 / Hour=5  Minute=0 -->
        <!--   America/New_York:    Hour=6  Minute=30 / Hour=8  Minute=0 -->
        <!--   UTC:                 Hour=10 Minute=30 / Hour=12 Minute=0 -->
        <!--   Asia/Hong_Kong:      Hour=18 Minute=30 / Hour=20 Minute=0 -->
        <!-- Defaults below assume Asia/Hong_Kong. -->
        <dict>
            <key>Hour</key>
            <integer>18</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/path/to/warehouse/logs/launchd/com.livewire.daily-update-watchdog.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/path/to/warehouse/logs/launchd/com.livewire.daily-update-watchdog.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
