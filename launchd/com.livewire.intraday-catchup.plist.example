<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.livewire.intraday-catchup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Replace /path/to/warehouse with your actual warehouse path. Runs the
             immutable release `current` points at, not the dev checkout. -->
        <string>cd /path/to/warehouse/current &amp;&amp; .venv/bin/python scripts/livewire_ops.py run-intraday-catchup-job</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Target: 10:00 UTC daily. This job runs SECOND of the two lake writers and is -->
        <!-- the low-priority holder of <warehouse>/locks/lake-io.lock: each phase polls -->
        <!-- for the lock once a minute (the daily job polls every second), so a daily -->
        <!-- lane always wins the next acquire. A phase that never gets the lock within -->
        <!-- its budget is recorded outcome='blocked', blocker='lake_lock' and skipped. -->
        <!-- Massive whole-market SIP minute files for trade-date D are available shortly -->
        <!-- after midnight ET on D+1, so a 10:00Z start carries no data-availability -->
        <!-- risk. launchd interprets Hour/Minute in the Mac's local TZ, with no TimeZone -->
        <!-- key support. Examples: -->
        <!--   America/Los_Angeles: Hour=3  Minute=0  (PDT summer) -->
        <!--   America/New_York:    Hour=6  Minute=0  (EDT summer) -->
        <!--   UTC:                 Hour=10 Minute=0 -->
        <!--   Asia/Hong_Kong:      Hour=18 Minute=0  (no DST, year-round) -->
        <!-- Defaults below assume Asia/Hong_Kong. -->
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/com.livewire.intraday-catchup.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.livewire.intraday-catchup.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
