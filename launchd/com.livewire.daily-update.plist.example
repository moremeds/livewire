<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.livewire.daily-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Replace /path/to/warehouse with your actual warehouse path. This runs the
             immutable release `current` points at, NOT the dev checkout, and uses that
             release's own frozen venv — so editing or breaking the working tree cannot
             change what runs tonight. See `livewire_ops.py release`. -->
        <string>cd /path/to/warehouse/current &amp;&amp; .venv/bin/python scripts/livewire_ops.py run-daily-job</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Target: 05:00 UTC daily (= 01:00 ET EDT / 00:00 ET EST). This job runs FIRST -->
        <!-- of the two lake writers: it holds the lake-io lock per lane, and the -->
        <!-- intraday-catchup job (10:00Z) defers behind it. Before 2026-09-06 the two -->
        <!-- overlapped for the whole night and corporate-actions hit its 3h budget four -->
        <!-- nights running while a lake-alone run of the same lane took 39 minutes. -->
        <!-- The ORDER is enforced by <warehouse>/locks/lake-io.lock, not by these two -->
        <!-- files; the times only keep the arrival order sane. 05:00Z still leaves a -->
        <!-- 1h15m buffer after IBC's 03:45 UTC auto-restart (AutoRestartTime=11:45 ET) -->
        <!-- and the 2FA approval window, and 30 min after release-promote (04:30Z). -->
        <!-- launchd interprets Hour/Minute in the Mac's local TZ, with no TimeZone key -->
        <!-- support. Examples: -->
        <!--   America/Los_Angeles: Hour=22 Minute=0 (previous day) -->
        <!--   America/New_York:    Hour=1  Minute=0 -->
        <!--   UTC:                 Hour=5  Minute=0 -->
        <!--   Asia/Hong_Kong:      Hour=13 Minute=0 -->
        <!-- Defaults below assume Asia/Hong_Kong. -->
        <key>Hour</key>
        <integer>13</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/com.livewire.daily-update.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.livewire.daily-update.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
