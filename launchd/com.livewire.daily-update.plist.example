<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.livewire.daily-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Replace /path/to/warehouse with your actual warehouse path. This runs the
             immutable release `current` points at, NOT the dev checkout, and uses that
             release's own frozen venv — so editing or breaking the working tree cannot
             change what runs tonight. See `livewire_ops.py release`. -->
        <string>cd /path/to/warehouse/current &amp;&amp; .venv/bin/python scripts/livewire_ops.py run-daily-job</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Target: 06:00 UTC daily (= 02:00 ET EDT / 01:00 ET EST). Shifted from 05:05 to -->
        <!-- give a 2h+ buffer after IBC's 03:45 UTC auto-restart (AutoRestartTime=11:45 ET) -->
        <!-- and the 2FA approval window. launchd interprets Hour/Minute in the Mac's local -->
        <!-- TZ; choose values that map to 06:00 UTC. Examples: -->
        <!--   America/Los_Angeles: Hour=22 Minute=0 (previous day) -->
        <!--   America/New_York:    Hour=2  Minute=0 -->
        <!--   UTC:                 Hour=6  Minute=0 -->
        <!--   Asia/Hong_Kong:      Hour=14 Minute=0 -->
        <!-- Defaults below assume Asia/Hong_Kong. -->
        <key>Hour</key>
        <integer>14</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/com.livewire.daily-update.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.livewire.daily-update.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
