<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.livewire.daily-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Replace /path/to/repo with your actual repo path -->
        <string>cd /path/to/repo &amp;&amp; /Users/chenxi/market-warehouse/.venv/bin/python scripts/livewire_ops.py run-daily-job</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Target: 05:05 UTC daily (= 01:05 ET, ~9h after US RTH close — well clear of -->
        <!-- the trading day on either DST setting). launchd interprets Hour/Minute in the -->
        <!-- Mac's local TZ; choose values that map to 05:05 UTC. Examples: -->
        <!--   America/Los_Angeles: Hour=22 Minute=5 (previous day) -->
        <!--   America/New_York:    Hour=1  Minute=5 -->
        <!--   UTC:                 Hour=5  Minute=5 -->
        <!--   Asia/Hong_Kong:      Hour=13 Minute=5 -->
        <!-- Defaults below assume Asia/Hong_Kong. -->
        <key>Hour</key>
        <integer>13</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/com.livewire.daily-update.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.livewire.daily-update.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
