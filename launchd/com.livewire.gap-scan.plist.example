<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Registry-driven gap scan. Read-only in Phase 1: it writes its two artifacts
  and mutates nothing in the lake. The manifest is NOT fed to shepherd_repair
  yet — no unattended mutation is scheduled until the denominator has been
  observed correct on real data.

  It runs after com.livewire.coverage (11:00 UTC) for the same reason coverage
  runs after the daily job's deadline: a lane still publishing while this walks
  bronze produces a mixed-time snapshot and false "missing" counts.

  The start/end window arguments together with this StartCalendarInterval are
  how the freshness SLA is expressed. There is no separate SLA evaluator; one
  would duplicate the scheduler.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.livewire.gap-scan</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Replace /path/to/warehouse with your actual warehouse path. Runs the
             immutable release `current` points at, like the other warehouse jobs.
             The start argument is a 30-day trailing window: wide enough to catch a
             lane silently dead for weeks, narrow enough to stay cheap. -->
        <string>cd /path/to/warehouse/current &amp;&amp; .venv/bin/python scripts/livewire_quality.py gap-scan --bronze-root /path/to/warehouse/data-lake/bronze --start $(date -u -v-30d +%Y-%m-%d) --end $(date -u -v-1d +%Y-%m-%d) --unresolved /path/to/warehouse/data-lake/repairs/gaps/unresolved.json --manifest-out /path/to/warehouse/data-lake/repairs/gaps/manifest.json --decisions-out /path/to/warehouse/data-lake/repairs/gaps/decisions.json</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Target: 12:00 UTC daily. After com.livewire.coverage at 11:00 UTC, -->
        <!-- which is itself after the daily job's 4h deadline (10:00 UTC) and -->
        <!-- the 10:30 UTC watchdog. -->
        <!-- launchd has no TimeZone key, so Hour/Minute are Mac-local: -->
        <!--   Asia/Hong_Kong:      Hour=20 Minute=0 -->
        <!--   America/New_York:    Hour=8  Minute=0 -->
        <!--   Europe/London:       Hour=13 Minute=0 -->
        <!--   UTC:                 Hour=12 Minute=0 -->
        <!-- Defaults below assume Asia/Hong_Kong. -->
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/com.livewire.gap-scan.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.livewire.gap-scan.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- /opt/homebrew/bin is load-bearing across the warehouse jobs: the
             shared alert path shells out to the Nodemailer CLI, and launchd's
             minimal PATH cannot find `node`. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
